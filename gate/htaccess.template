# BERNS gate: whole site is private until you remove this file.
# Generated by gate/setup.sh (it swaps in a random token). Never commit the generated .htaccess.
# MX / email records are DNS, so none of this touches Zoho mail.

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Anyone without the unlock cookie gets the gate page instead of the site
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)berns_gate=__GATE_TOKEN__(;|$)
  RewriteCond %{REQUEST_URI} !^/gate/
  RewriteCond %{REQUEST_URI} !^/(favicon\.svg|favicon-32\.png|apple-touch-icon\.png)$
  RewriteRule ^ /gate/index.php [L]
</IfModule>

# Keep the gate's own secrets unreadable
<FilesMatch "^(config\.php|setup\.sh|htaccess\.template)$">
  Require all denied
</FilesMatch>
